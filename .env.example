# URL del despliegue. En staging es la de Cloudflare Pages.
PUBLIC_SITE_URL=https://alina-website.pages.dev

# true mientras el sitio esté en revisión: mete noindex en todas las páginas,
# cierra robots.txt y muestra la banda de aviso.
# Se pone en false el día del lanzamiento, con dominio propio.
PUBLIC_STAGING=true

# Pages Function del formulario (ADR 003). Sin esto el formulario no envía.
CORREO_DESTINO=
API_CORREO=
