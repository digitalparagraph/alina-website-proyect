# URL del despliegue, con subcarpeta si la hay. Es la única variable que fija
# dónde vive el sitio: de su origen sale el canonical y el sitemap, y de su ruta
# el prefijo de todos los enlaces internos.
#
#   https://dev.paragraph.mx/alina   revisión, en subcarpeta
#   https://alinamartinez.mx         producción, en la raíz
#
# Sin ella, un build local usa http://localhost:4321. En el servidor la carga el
# workflow de deploy desde las variables del repositorio, no desde este archivo.
PUBLIC_SITE_URL=

# true mientras el sitio esté en revisión: mete noindex en todas las páginas,
# cierra robots.txt y muestra la banda de aviso.
# Se pone en false el día del lanzamiento, con dominio propio.
PUBLIC_STAGING=true

# El formulario no se configura aquí. Es un script PHP que corre en Hostinger
# (ADR 008) y lee sus credenciales de php/config.php, que se sube una sola vez
# a mano al servidor. La plantilla está en php/config.example.php.

# --- Subida por SSH ---
# Mismos nombres que herramientas/deploy-ssh.sh del proyecto App Paragraph:
# es la misma cuenta de hosting, así que un solo juego de variables.
# La clave sale por defecto de ~/.ssh/paragraph_hostinger y nunca se versiona.
SSH_HOST=46.202.197.103
SSH_USER=u842740011
SSH_PORT=65002
SSH_DESTINO=/home/u842740011/domains/paragraph.mx/public_html/dev-projects/alina
