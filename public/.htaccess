# Sitio estatico generado con Astro. Hostinger sirve Apache o LiteSpeed.
#
# Este archivo esta escrito para un dominio en su raiz, que es donde ira
# produccion. Para un despliegue en subcarpeta, `npm run preparar` reescribe
# en dist/ las dos directivas que dependen de la ubicacion: ErrorDocument y la
# cabecera de no indexado. Si ese paso no corre, lo que se sube sigue siendo
# valido para la raiz.

# HTTPS obligatorio
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Astro genera /pagina/index.html. Se sirve el index de cada carpeta.
DirectoryIndex index.html

# Barra final consistente: /pagina -> /pagina/
# Se redirige con %{REQUEST_URI} y no con $1: en un .htaccess de subcarpeta,
# Apache entrega la ruta ya recortada, asi que $1 mandaria /pagina/ a la raiz
# del dominio en lugar de a /alina/pagina/.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(/$|\.)
  RewriteRule ^(.*)$ %{REQUEST_URI}/ [L,R=301]
</IfModule>

# Astro emite el 404 como 404.html en la raiz, no como 404/index.html, incluso
# con build.format directory. Apuntarlo a la carpeta deja al visitante con el
# error genérico del servidor.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Los assets de /_astro/ llevan hash en el nombre: se cachean un año y son
  # inmutables. El resto no lleva hash —el retrato, los logos— y con un año
  # inmutable un cambio de foto tardaria un año en verse. Esos van a un dia.
  <FilesMatch "\.(woff2|woff|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|png|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain
</IfModule>
