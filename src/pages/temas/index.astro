---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ruta } from '../../lib/rutas';
import { AREAS_SIN_PAGINA } from '../../data/areas-de-trabajo';
// Se listan todas las que existen. El filtro por fase dejaba fuera las de
// fase 2 cuando no estaban escritas; ahora lo están (ADR 009) y ocultarlas
// sería esconder páginas publicadas.
const temas = (await getCollection('temas'))
  .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es'));
---
<Base
  titulo="Temas que se trabajan en el proceso"
  descripcion="Los patrones que se trabajan con más frecuencia: autoexigencia, sobrepensar, procrastinación, límites en las relaciones y decisiones que llevan meses abiertas."
>
  <section>
    <header class="banda banda--crema portada-pagina">
      <div class="contenedor pila">
        <h1>Temas</h1>
        <p class="entrada">
          Estos son los patrones que aparecen con más frecuencia. Rara vez vienen solos: quien se exige de más suele
          también sobrepensar, y quien sobrepiensa suele posponer.
        </p>
        <p class="medida">
          Todos se trabajan dentro del mismo proceso:
          <a href={ruta('/que-es-el-coaching-terapeutico/')}>qué es el coaching terapéutico</a>
          explica en qué consiste y hasta dónde llega.
        </p>
      </div>
    </header>

    <div class="contenedor seccion pila">
    <ul class="lista">
      {temas.map((t) => (
        <li>
          <h2><a href={ruta(`/temas/${t.slug}/`)}>{t.data.titulo}</a></h2>
          <p>{t.data.reconocimiento}</p>
        </li>
      ))}
    </ul>

    <!-- Un área que todavía no tenga página se nombra aquí, sin enlace. Hoy no
         hay ninguna; el bloque se conserva para que añadir un área nueva no
         obligue a rehacer la página. -->
    {AREAS_SIN_PAGINA.length > 0 && (
      <section class="otras pila">
        <h2>También se trabajan</h2>
        <ul class="lista-simple">
          {AREAS_SIN_PAGINA.map((a) => (
            <li><b>{a.nombre}.</b> {a.cubre}</li>
          ))}
        </ul>
      </section>
    )}
    </div>
  </section>
</Base>

<style>
  .entrada{font-size:var(--text-lg);line-height:var(--leading-normal)}
  .otras{border-top:1px solid var(--border-hairline);padding-top:var(--space-6)}
  .otras h2{font-size:var(--text-h3)}
  .lista-simple{list-style:none;margin:0;padding:0;max-width:var(--measure);
    display:flex;flex-direction:column;gap:var(--space-4);font-size:var(--text-sm)}
  .lista{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:var(--space-7)}
  .lista li{border-top:1px solid var(--border-hairline);padding-top:var(--space-4)}
  .lista h2{margin-bottom:var(--space-3)}
  .lista a{text-decoration:none}
  .lista a:hover{text-decoration:underline}
</style>
