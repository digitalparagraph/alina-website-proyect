---
import Base from '../layouts/Base.astro';
import { ruta } from '../lib/rutas';
import { AREAS_CON_PAGINA, AREAS_SIN_PAGINA } from '../data/areas-de-trabajo';

/** Los ocho reconocimientos de la guía de contenido. Es el bloque de
 *  identificación más importante del sitio. Pendiente que Alina confirme si
 *  falta alguno o si alguno no aparece nunca en consulta. */
const reconocimientos = [
  'Sabes que quieres hacer cambios y sigues repitiendo ciertos patrones.',
  'Sobrepiensas decisiones o situaciones una y otra vez.',
  'Te cuesta poner límites sin sentir culpa.',
  'Eres muy exigente contigo y te cuesta bajar el nivel.',
  'Hay cosas que entiendes perfectamente y que emocionalmente sigues viviendo igual.',
  'Estás atravesando una etapa de cambio y necesitas ordenar qué quieres.',
  'Tus relaciones, tu trabajo o tus decisiones están empezando a resentir un patrón que quieres comprender.',
  'Lo has intentado por tu cuenta y sientes que sigues dando vueltas en el mismo lugar.',
];

const fases = [
  ['Entender', 'Qué está ocurriendo, qué lo desencadena y qué lo mantiene.'],
  ['Observar', 'Cómo se relacionan pensamientos, emociones y conductas en situaciones concretas.'],
  ['Experimentar', 'Probar respuestas distintas y aprender de lo que ocurre.'],
  ['Integrar', 'Convertir eso en herramientas que puedas usar sin acompañamiento.'],
];

---
<Base
  titulo="Alina Martínez · Coaching terapéutico en línea"
  descripcion="Acompañamiento para comprender y modificar patrones de pensamiento, emoción y conducta que interfieren con cómo quieres vivir, decidir o relacionarte."
>
  <!-- Héroe sobre el campo de marca. Sin retrato: el protagonista es el
       proceso, no la coach, y ese es el primer criterio de la guía de
       contenido. El aire grande es intencional y se queda vacío. -->
  <section class="banda banda--butter marco apertura">
    <svg class="arco arco--hero" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
      <circle cx="200" cy="200" r="199" fill="none" stroke="currentColor" stroke-width="1" />
      <circle cx="200" cy="200" r="148" fill="none" stroke="currentColor" stroke-width="1" />
    </svg>

    <div class="contenedor pila">
      <p class="eyebrow">coaching terapéutico en línea</p>
      <!-- El titular nombra el mecanismo tal como lo formula la guía: saber qué
           necesitas y aun así no poder. La versión anterior decía "cosas que
           entiendes y aun así sigues haciendo", que apunta al revés que su
           propio subtítulo y que la guía. -->
      <h1>
        Entender qué te pasa
        <span class="marcador marcador--papel">no siempre alcanza</span>
        para cambiarlo.
      </h1>
      <p class="entrada">
        Saber que necesitas poner un límite no es lo mismo que poder ponerlo.
        Este es un espacio para entender qué mantiene ese patrón y qué otras
        respuestas tienes disponibles.
      </p>
      <p><a href={ruta('/agendar/')} class="boton boton--papel">Agendar una primera sesión</a></p>
    </div>
  </section>

  <section class="banda banda--pagina">
    <div class="contenedor pila">
      <h2 class="titular">Este espacio puede ser para ti si</h2>
      <ul class="reconocimientos">
        {reconocimientos.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <section class="banda banda--crema">
    <div class="contenedor pila">
      <div class="grupo-titulo">
        <p class="eyebrow">temas</p>
        <h2 class="titular">Qué puedes trabajar</h2>
      </div>
      <!-- Las cinco áreas de la guía, como pide el brief de la Etapa 2. Las que
           tienen página van en tarjeta, porque una tarjeta promete un destino;
           las que no, en texto. Mezclarlas dejaba dos tarjetas con un hueco
           donde iría el enlace, y eso se lee como algo que falló al cargar.

           Las tarjetas van todas iguales: el kit del sistema alterna tonos, pero
           ahí son tres ofertas distintas y aquí son áreas equivalentes. Lo que
           las separa es la hairline y el aire, no el color. -->
      <ul class="rejilla temas">
        {AREAS_CON_PAGINA.map((a) => (
          <li class="tarjeta tarjeta--papel">
            <h3>{a.nombre}</h3>
            <p>{a.cubre}</p>
            <p class="tarjeta-enlace">
              <a href={ruta(`/temas/${a.tema}/`)}>Ver el tema</a>
            </p>
          </li>
        ))}
      </ul>

      <div class="tambien">
        <h3>También se trabajan</h3>
        <ul class="lista-simple">
          {AREAS_SIN_PAGINA.map((a) => (
            <li><b>{a.nombre}.</b> {a.cubre}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="banda banda--pagina">
    <div class="contenedor pila">
      <div class="grupo-titulo">
        <p class="eyebrow">el proceso</p>
        <h2 class="titular">Cómo se trabaja</h2>
      </div>
      <ol class="fases">
        {fases.map(([n, t], i) => (
          <li>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div><b>{n}.</b> {t}</div>
          </li>
        ))}
      </ol>
      <p><a href={ruta('/proceso/')}>Ver el proceso completo</a></p>
    </div>
  </section>

  <!-- El retrato acompaña al bloque que presenta a quien acompaña, que es
       donde el texto ya la introduce. En el kit del sistema la fotografía
       vive en esta superficie, no en el héroe. -->
  <section class="banda banda--mist">
    <div class="contenedor par">
      <div class="pila">
        <div class="grupo-titulo">
          <p class="eyebrow">sobre alina</p>
          <h2 class="titular">Qué es esto</h2>
        </div>
        <p class="medida">
          Coaching terapéutico: un proceso que combina herramientas de coaching
          con principios de la terapia cognitivo conductual. Tiene un alcance
          definido y no sustituye psicoterapia. Quien acompaña es
          <span class="pincel">coach certificada con formación en TCC</span>.
        </p>
        <hr class="regla" />
        <p class="enlaces">
          <a href={ruta('/que-es-el-coaching-terapeutico/')}>Qué incluye</a>
          <a href={ruta('/terapia-o-coaching/')}>En qué se diferencia de la terapia</a>
          <a href={ruta('/sobre-alina/')}>Quién acompaña</a>
        </p>
      </div>
      <div>
        <picture>
          <source srcset={ruta('/img/alina-retrato.webp')} type="image/webp" />
          <img class="retrato" src={ruta('/img/alina-retrato.jpg')}
               alt="Alina Martínez" width="900" height="900"
               loading="lazy" decoding="async" />
        </picture>
      </div>
    </div>
  </section>

  <section class="banda banda--lila objecion">
    <div class="contenedor pila">
      <h2 class="titular">"¿Lo que me pasa es suficientemente importante?"</h2>
      <p class="medida">
        No hace falta estar al límite para pedir acompañamiento. Si algo está
        ocupando demasiado espacio mental, o afectando tus relaciones, tus
        decisiones o tu descanso, ya es razón suficiente para explorarlo.
      </p>
      <p class="medida">
        Esperar a estar suficientemente mal es, de hecho, uno de los patrones
        más comunes. Y los patrones tienden a sostenerse mientras las
        condiciones que los mantienen sigan igual.
      </p>
      <p class="medida">
        A veces lo que detiene es la idea de que deberías poder resolverlo por
        tu cuenta. Pedir ayuda para entender un patrón no dice nada sobre lo
        que eres capaz de manejar.
      </p>
    </div>
  </section>

  <section class="banda banda--pagina">
    <div class="contenedor pila">
      <p class="entrada medida">
        La primera sesión sirve para entender qué está pasando y para que
        valores si esta forma de trabajo tiene sentido para ti.
      </p>
      <p><a href={ruta('/agendar/')} class="boton">Agendar una primera sesión</a></p>
    </div>
  </section>
</Base>

<style>
  /* El titular del héroe es la única pieza a tamaño display del sitio. Lleva
     interlineado algo mayor que --leading-tight porque carga una cápsula de
     marcador: a 1.06 la pintura no tiene dónde caber sin tocar la línea de al
     lado. Un titular sin cápsula sí usa el token cerrado. */
  .apertura h1{font-size:var(--text-display);line-height:1.12;max-width:20ch}
  .apertura .entrada{max-width:38ch}
  .apertura > .contenedor{position:relative;padding-block:var(--space-6)}
  .entrada{font-size:var(--text-lg);line-height:var(--leading-normal)}

  .reconocimientos{list-style:none;margin:0;padding:0;display:grid;
    gap:var(--space-4) var(--space-6);
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
  .reconocimientos li{border-left:3px solid var(--accent-highlight);
    padding-left:var(--space-4);font-size:var(--text-sm)}

  .temas{list-style:none;margin:0;padding:0}
  .temas h3{margin:0}
  .temas p{font-size:var(--text-sm);color:var(--text-secondary);margin:0}
  /* El enlace se ancla abajo para que las tres tarjetas compartan línea de base
     aunque sus descripciones midan distinto. */
  .tarjeta-enlace{margin-top:auto;padding-top:var(--space-4)}

  .tambien{display:flex;flex-direction:column;gap:var(--space-3)}
  .tambien h3{font-size:var(--text-lg)}
  .lista-simple{list-style:none;margin:0;padding:0;max-width:var(--measure);
    display:flex;flex-direction:column;gap:var(--space-3);font-size:var(--text-sm)}
  .tarjeta-enlace a{font-weight:var(--weight-bold);color:var(--text-primary)}

  .fases{list-style:none;margin:0;padding:0;max-width:var(--measure);
    display:flex;flex-direction:column;gap:var(--space-4)}
  .fases li{display:grid;grid-template-columns:auto 1fr;gap:var(--space-4);align-items:baseline}
  .num{font-weight:var(--weight-bold);font-variant-numeric:tabular-nums;
    color:var(--lilac-700)}

  .enlaces{display:flex;flex-wrap:wrap;gap:var(--space-2) var(--space-5);max-width:none}

  .objecion h2{max-width:26ch}
</style>
