---
import '@fontsource/poppins/latin-300.css';
import '@fontsource/poppins/latin-700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { Picture } from 'astro:assets';
import logoPie from '../assets/logo-blanco.png';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Persona from '../components/schema/Persona.astro';
import { ruta, raizAbsoluta } from '../lib/rutas';

const { titulo, descripcion, noindex = false } = Astro.props;

// Mientras no haya dominio, el despliegue es de staging y no debe indexarse.
// Un sitio de pruebas con el copy real indexado antes de tiempo compite con
// el definitivo y expone borradores. Se apaga con PUBLIC_STAGING=false.
const staging = import.meta.env.PUBLIC_STAGING !== 'false';
const sitio = raizAbsoluta(Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// La marca se añade aquí y no en cada página: así ninguna se queda sin ella al
// crearse, y el texto que escribe quien redacta es el que describe la página.
// Las que ya la llevan en la frase no la repiten.
const MARCA = 'Alina Martínez';
const tituloCompleto = titulo.includes(MARCA) ? titulo : `${titulo} · ${MARCA}`;

// Imagen de la tarjeta al compartir. Absoluta porque las redes no resuelven
// rutas relativas, y con la raíz del despliegue para que funcione en subcarpeta.
const imagenSocial = new URL(ruta('/og.png'), Astro.site).href;

const nav = [
  { href: '/proceso/', texto: 'El proceso' },
  { href: '/temas/', texto: 'Temas' },
  { href: '/terapia-o-coaching/', texto: 'Enfoques' },
  { href: '/sobre-alina/', texto: 'Sobre Alina' },
];

// El subrayado de un pixel marca en que seccion esta el visitante. Se compara
// por prefijo para que una pagina de tema mantenga marcado "Temas", y contra la
// ruta ya prefijada, porque en subcarpeta el pathname trae el /alina delante.
const rutaActual = Astro.url.pathname;
const enSeccion = (href) => {
  const destino = ruta(href);
  return rutaActual === destino || rutaActual.startsWith(destino);
};
---
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  {(noindex || staging) && <meta name="robots" content="noindex,nofollow" />}

  <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
  <link rel="icon" href={ruta('/favicon-32.png')} sizes="32x32" />
  <link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />

  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={MARCA} />
  <meta property="og:image" content={imagenSocial} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Alina Martínez · existir consciente" />
  <!-- summary_large_image y no summary: con la tarjeta chica la imagen se
       recorta a cuadrado y el lockup pierde el nombre. -->
  <meta name="twitter:card" content="summary_large_image" />
  <Persona sitio={sitio} />
  <slot name="schema" />
</head>
<body>
  {staging && (
    <p class="banda-staging">
      Sitio en revisión. Contenido pendiente de aprobación, no público.
    </p>
  )}

  <a href="#contenido" class="saltar">Saltar al contenido</a>

  <header class="cabecera">
    <div class="contenedor cabecera-fila">
      <a href={ruta('/')} class="marca" aria-label="Alina Martínez, inicio">
        <img src={ruta('/logo/alina-logo.svg')} alt="Alina Martínez · existir consciente"
             width="200" height="127" />
      </a>
      <!-- Agendar sale de la lista de navegación: es una acción, no una
           sección, y fuera de la lista puede compartir fila con el logo en
           pantalla angosta en lugar de empujar una tercera fila. -->
      <nav aria-label="Principal">
        <ul>
          {nav.map((i) => (
            <li>
              <a
                href={ruta(i.href)}
                class:list={['nav-enlace', { activo: enSeccion(i.href) }]}
                aria-current={enSeccion(i.href) ? 'page' : undefined}
              >{i.texto}</a>
            </li>
          ))}
        </ul>
      </nav>

      <a href={ruta('/agendar/')} class="boton boton--papel accion-cabecera">Agendar</a>
    </div>
  </header>

  <main id="contenido"><slot /></main>

  <BotonWhatsApp />

  <footer class="pie">
    <div class="contenedor pie-fila">
      <!-- El PNG de origen mide 588 px y en el pie nunca se ve a más de 200.
           Se emite al tamaño real, con su 2x. -->
      <Picture
        src={logoPie}
        formats={['avif', 'webp']}
        fallbackFormat="png"
        width={200}
        densities={[1, 2]}
        alt="Alina Martínez"
        class="pie-logo"
        loading="lazy"
        decoding="async"
      />

      <p class="pie-nota">
        Coaching terapéutico en línea. Sesiones individuales de aproximadamente
        50 minutos, habitualmente cada 15 días.
      </p>

      <ul class="pie-enlaces">
        <!-- /sobre-alina/ va en el pie de todas las páginas: E-E-A-T pide que
             la autoría sea alcanzable desde cualquier punto del sitio. -->
        <li><a href={ruta('/sobre-alina/')}>Sobre Alina</a></li>
        <li><a href={ruta('/alcance-del-servicio/')}>Alcance del servicio</a></li>
        <li><a href={ruta('/preguntas-frecuentes/')}>Preguntas frecuentes</a></li>
        <li><a href={ruta('/aviso-de-privacidad/')}>Aviso de privacidad</a></li>
        <li><a href={ruta('/terminos-y-condiciones/')}>Términos y condiciones</a></li>
      </ul>
    </div>
  </footer>
</body>
</html>

<style>
  /* max-width explícito: la regla de medida de lectura aplica a todo p y aquí
     recortaba la banda a 62 caracteres en lugar de cruzar la pantalla. */
  .banda-staging{margin:0;max-width:none;padding:var(--space-2) var(--space-5);
    text-align:center;background:var(--ink-800);color:var(--text-inverse);
    font-size:var(--text-xs);letter-spacing:var(--tracking-wide)}

  .saltar{position:absolute;left:-9999px;top:var(--space-3)}
  .saltar:focus{left:var(--space-5);background:var(--surface-card);padding:var(--space-3) var(--space-4);z-index:30}

  /* La cabecera va sobre el campo de marca y se queda fija al desplazar. El
     sistema la resuelve así: mantequilla, lockup a la izquierda y navegación
     con subrayado de un píxel. Sin sombra: la marca es plana. */
  .cabecera{position:sticky;top:0;z-index:20;background:var(--surface-brand)}
  .cabecera-fila{display:flex;flex-wrap:wrap;gap:var(--space-4);
    align-items:center;justify-content:space-between;padding-block:var(--space-3)}
  .marca{text-decoration:none;display:block;line-height:0}
  .marca img{width:clamp(120px,15vw,168px);height:auto}
  nav ul{display:flex;flex-wrap:wrap;gap:var(--space-3) var(--space-5);
    align-items:center;list-style:none;margin:0;padding:0;font-size:var(--text-base)}

  .nav-enlace{text-decoration:none;padding-bottom:3px;
    border-bottom:1px solid transparent;
    transition:border-color var(--dur-base) var(--ease)}
  .nav-enlace:hover,.nav-enlace.activo{border-bottom-color:var(--border-hairline)}

  /* Debajo de 820 px la cabecera parte en dos filas y, fija, se comería un
     tercio de la pantalla. Ahí deja de ser fija y se desplaza con la página. */
  @media (max-width:820px){
    .cabecera{position:static}
  }

  /* Dos filas, no tres: logo y acción arriba, secciones debajo. */
  @media (max-width:760px){
    .marca{order:1}
    .accion-cabecera{order:2}
    nav{order:3;flex-basis:100%}
    nav ul{gap:var(--space-2) var(--space-4);font-size:var(--text-sm)}
    .accion-cabecera{padding:var(--space-2) var(--space-5)}
  }

  /* El pie cierra en negro con el lockup en blanco. Es el único bloque oscuro
     del sitio: el sistema lo usa como cierre, no como decoración. */
  .pie{background:var(--surface-inverse);color:var(--text-inverse);
    padding-block:var(--space-8)}
  .pie-fila{display:grid;gap:var(--space-6) var(--space-8);align-items:start}
  @media (min-width:900px){
    .pie-fila{grid-template-columns:auto minmax(0,1fr) auto}
  }
  .pie-logo{width:clamp(150px,17vw,200px);height:auto}
  .pie-nota{max-width:34ch;margin:0;font-size:var(--text-sm);color:var(--gray-300)}
  .pie-enlaces{display:flex;flex-direction:column;gap:var(--space-2);
    list-style:none;margin:0;padding:0;font-size:var(--text-sm)}
  .pie a{color:var(--white)}
</style>
